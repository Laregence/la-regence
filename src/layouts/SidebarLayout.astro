---
// Lien "Bon cadeau" dans le menu : passer à true quand Stripe est en mode production
const SHOW_BON_CADEAU = true;
import "../styles/global.css";
const {
  title = "La Régence",
  description = "",
  active = "",
  ogImage = "/og-image.jpg",
  noScroll = false, // ✅ NEW
} = Astro.props;
// Canonical dynamique (utilise astro.config.site si défini)
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.toString();

const ogImageUrl = Astro.site
  ? new URL(ogImage, Astro.site).toString()
  : ogImage;

// Liens du menu latéral (version ordinateur)
const navItems = [
  { key: "carte", href: "/menu", label: "Carte" },
  { key: "boissons", href: "/boissons", label: "Boissons" },
  { key: "la-regence", href: "/la-regence", label: "La Régence", noTranslate: true },
  { key: "contact", href: "/contact", label: "Contact" },
  ...(SHOW_BON_CADEAU ? [{ key: "bon-cadeau", href: "/bon-cadeau/", label: "Bon cadeau" }] : []),
  { key: "recrutement", href: "/recrutement", label: "Recrutement" },
];
const year = new Date().getFullYear();
---


<html lang="fr">
  <head>
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Réservations" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Limelight&family=Noto+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />

  <link rel="canonical" href={canonical} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/jpg" />

  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/svg+xml" href="/favicon.png" />
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "@id": "https://laregencemdm.fr/#restaurant",
  "name": "La Régence",
  "image": "https://laregencemdm.fr/photos/exterieur.jpg",
  "url": "https://laregencemdm.fr",
  "telephone": "+33558859272",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "2 rue Léon Gambetta",
    "addressLocality": "Mont-de-Marsan",
    "postalCode": "40000",
    "addressCountry": "FR"
  },
  "servesCuisine": [
    "Cuisine française",
    "Brasserie"
  ],
  "priceRange": "€€",
  "sameAs": [
    "https://www.facebook.com/LaRegenceMDM",
    "https://www.instagram.com/la_regence_mdm/"
  ]
}
</script>

<script is:inline>
  function loadScript(a) {
    var b = document.getElementsByTagName("head")[0],
        c = document.createElement("script");

    c.type = "text/javascript";
    c.src = "https://tracker.metricool.com/resources/be.js";
    c.onreadystatechange = a;
    c.onload = a;
    b.appendChild(c);
  }

  loadScript(function () {
    beTracker.t({
      hash: "5f858a9bd6e9c34e83f46228987d83ca"
    });
  });
</script>

</head>


  <body class="min-h-screen text-slate-900 overflow-x-hidden md:overflow-hidden">

    <!-- ===== HEADER MOBILE (bandeau translucide) ===== -->
<header class="md:hidden fixed inset-x-0 top-0 z-40">
  <div class="h-24 flex items-center justify-between px-4 backdrop-blur bg-black/10">
    
    <!-- Burger -->
    <button id="mb-open" aria-label="Ouvrir le menu" class="p-2 rounded-md text-brand/90 active:scale-95">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>

    <!-- Texte + Logo -->
    <div class="flex items-center gap-4">
      <a 
        href="/" 
        aria-label="Accueil" 
        class="font-limelight uppercase text-3xl sm:text-4xl text-white"
        style="text-shadow: 1px 1px 2px black, -1px -1px 2px black;"
      >
        <span translate="no" class="notranslate">LA RÉGENCE</span>
      </a>
      <a href="/" aria-label="Accueil">
        <img src="/logo.png" alt="La Régence" class="h-20 w-auto" /> <!-- Taille doublée -->
      </a>
    </div>
  </div>
</header>





    <!-- ===== DRAWER MOBILE (plein écran, slide gauche) ===== -->
<div id="mb-drawer" class="md:hidden fixed inset-x-0 top-0 h-[100dvh] z-50 hidden">
  <!-- Backdrop -->
  <div id="mb-backdrop" class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"></div>

  <!-- Panneau -->
  <aside
    id="mb-panel"
    class="relative h-full w-full bg-brand text-[var(--color-bg)] overflow-y-auto
           translate-x-[-100%] transition-transform duration-300 ease-out
           flex flex-col"
  >
    <!-- Bouton fermer (flottant) -->
    <button id="mb-close"
            aria-label="Fermer le menu"
            class="absolute left-4 top-3 p-2 rounded-md text-[var(--color-bg)] active:scale-95">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path stroke-linecap="round" stroke-width="2" d="M6 6l12 12M18 6l-12 12"/>
      </svg>
    </button>

    <!-- HAUT : LOGO -->
    <div class="pt-12 px-6 flex-shrink-0 flex items-start justify-center">
      <a href="/" aria-label="Accueil">
        <img src="/logo.png" alt="La Régence" class="w-[120px] max-w-full" />
      </a>
    </div>

    <!-- MILIEU : MENU + RÉSERVER + RÉSEAUX -->
    <div class="flex-1 min-h-0 flex flex-col items-center justify-center px-6 py-6 font-nour">
      <nav aria-label="Menu principal">
        <ul class="text-center">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={active === item.key ? "page" : undefined}
                class={`block py-2 text-[15px] font-medium uppercase tracking-[0.28em] transition-colors
                  ${active === item.key ? "text-[var(--color-bg)]" : "text-[#c9974a]"}`}
              >
                {item.noTranslate
                  ? <span translate="no" class="notranslate">{item.label}</span>
                  : item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <a
        href="/reservation"
        class="mt-7 block w-[180px] border-y-[1.5px] border-[var(--color-copper)] py-4 text-center
               text-[15px] font-bold uppercase tracking-[0.28em] text-[#c9974a]"
      >
        Réserver
      </a>

      <div class="mt-8 flex justify-center gap-3">
        <a href="https://www.instagram.com/la_regence_mdm/" target="_blank" rel="noopener"
           aria-label="Instagram"
           class="w-11 h-11 rounded-xl border-[1.5px] border-[#c9974a] text-[#c9974a] flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-[22px] h-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.2" cy="6.8" r="0.6"></circle>
          </svg>
        </a>
        <a href="https://www.facebook.com/LaRegenceMDM/" target="_blank" rel="noopener"
           aria-label="Facebook"
           class="w-11 h-11 rounded-xl border-[1.5px] border-[#c9974a] text-[#c9974a] flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-[22px] h-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path d="M14 8.5h2.5V5H14c-2.2 0-3.5 1.5-3.5 3.6V11H8v3.4h2.5V21H14v-6.6h2.5l.5-3.4h-3V9.2c0-.4.3-.7.6-.7z"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- BAS : mention + copyright -->
    <div class="flex-shrink-0 font-nour">
      <p class="text-center text-[12px] font-semibold uppercase tracking-[0.22em] leading-loose text-[#c9974a]">
        Bar · Restaurant · Brasserie
      </p>
      <footer class="mt-4 w-full border-t border-[#c9974a]/60 py-4 text-center text-[10px] font-semibold uppercase tracking-[0.22em] text-[#c9974a]">
        © <span translate="no" class="notranslate">La Régence</span> {year}<br />
        <a href="/mentions-legales/" class="inline-block mt-1 hover:text-[var(--color-bg)] transition-colors">Mentions légales</a>
      </footer>
    </div>
  </aside>
</div>



    <!-- ===== WRAPPER DESKTOP : grille 2 colonnes ===== -->
    <div class="md:grid md:grid-cols-[minmax(240px,320px)_1fr] md:h-dvh">

      <!-- Sidebar desktop FIXE (logo en haut, menu centré, reste en bas) -->
<aside class="hidden md:flex bg-brand text-[var(--color-bg)]
               md:sticky md:top-0 md:h-dvh md:overflow-y-auto
               flex-col justify-between">

  <!-- HAUT : logo -->
  <div class="pt-10 px-4 flex-shrink-0 flex items-start justify-center">
    <a href="/" aria-label="Accueil">
      <img src="/logo.png" alt="La Régence" class="w-[170px] max-w-full mx-auto cursor-pointer" />
    </a>
  </div>

  <!-- MILIEU : menu en petites capitales espacées -->
  <div class="flex-1 flex flex-col items-center justify-center px-4 font-nour">
    <nav aria-label="Menu principal">
      <ul class="text-center">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={active === item.key ? "page" : undefined}
              class={`block py-[7px] text-[15px] font-medium uppercase tracking-[0.28em] transition-colors
                ${active === item.key
                  ? "text-[var(--color-bg)]"
                  : "text-[#c9974a] hover:text-[var(--color-bg)]"}`}
            >
              {item.noTranslate
                ? <span translate="no" class="notranslate">{item.label}</span>
                : item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Réserver entre deux filets cuivre -->
    <a
      href="/reservation"
      class="mt-8 block w-[160px] border-y-[1.5px] border-[var(--color-copper)] py-4 text-center
             text-[15px] font-bold uppercase tracking-[0.28em] text-[#c9974a]
             hover:text-[var(--color-bg)] transition-colors"
    >
      Réserver
    </a>

    <!-- Réseaux : icônes au trait -->
    <div class="mt-9 flex justify-center gap-3">
      <a href="https://www.instagram.com/la_regence_mdm/" target="_blank" rel="noopener"
         aria-label="Instagram"
         class="w-11 h-11 rounded-xl border-[1.5px] border-[#c9974a] text-[#c9974a] flex items-center justify-center
                hover:text-[var(--color-bg)] hover:border-[var(--color-bg)] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-[22px] h-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
          <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.2" cy="6.8" r="0.6"></circle>
        </svg>
      </a>
      <a href="https://www.facebook.com/LaRegenceMDM/" target="_blank" rel="noopener"
         aria-label="Facebook"
         class="w-11 h-11 rounded-xl border-[1.5px] border-[#c9974a] text-[#c9974a] flex items-center justify-center
                hover:text-[var(--color-bg)] hover:border-[var(--color-bg)] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-[22px] h-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
          <path d="M14 8.5h2.5V5H14c-2.2 0-3.5 1.5-3.5 3.6V11H8v3.4h2.5V21H14v-6.6h2.5l.5-3.4h-3V9.2c0-.4.3-.7.6-.7z"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- BAS : mention + copyright -->
  <div class="flex-shrink-0 font-nour">
    <p class="text-center text-[12px] font-semibold uppercase tracking-[0.22em] leading-loose text-[#c9974a]">
      Bar<br />Restaurant<br />Brasserie
    </p>
    <footer class="mt-8 w-full border-t border-[#c9974a]/60 py-5 text-center text-[10px] font-semibold uppercase tracking-[0.22em] text-[#c9974a]">
      © <span translate="no" class="notranslate">La Régence</span> {year}<br />
        <a href="/mentions-legales/" class="inline-block mt-1 hover:text-[var(--color-bg)] transition-colors">Mentions légales</a>
    </footer>
  </div>
</aside>


      <!-- Contenu (colonne droite) -->
     <main
  class={`bg-main min-h-screen px-4 sm:px-6 md:px-8
          pt-24 pb-24 md:pt-0 md:pb-0 md:h-dvh ${noScroll ? "md:overflow-hidden" : "md:overflow-y-auto"}`}
>
  <slot />
</main>


    </div>

    <!-- ===== BANDEAU RÉSERVER MOBILE FIXE ===== -->
    <div class="md:hidden fixed inset-x-0 bottom-0 z-40">
      <a
        href="/reservation"
        aria-label="Réserver une table"
        class="h-24 w-full flex items-center justify-center
               bg-brand/95 backdrop-blur
               border-t-[3px] border-[var(--color-copper)]
               font-limelight text-3xl uppercase tracking-[0.12em]
               text-[var(--color-bg)]
               hover:text-[var(--color-copper)] transition"
      >
        Réserver
      </a>
    </div>

    <!-- ===== Scripts : drawer mobile ===== -->
    <script is:inline>
      (function () {
        const openBtn  = document.getElementById('mb-open');
        const closeBtn = document.getElementById('mb-close');
        const drawer   = document.getElementById('mb-drawer');
        const backdrop = document.getElementById('mb-backdrop');
        const panel    = document.getElementById('mb-panel');
        if (!openBtn || !closeBtn || !drawer || !backdrop || !panel) return;

        function openDrawer() {
          drawer.classList.remove('hidden');
          requestAnimationFrame(() => {
            backdrop.classList.add('opacity-100');
            panel.classList.remove('translate-x-[-100%]');
            panel.classList.add('translate-x-0');
            document.body.style.overflow = 'hidden';
          });
        }
        function closeDrawer() {
          backdrop.classList.remove('opacity-100');
          panel.classList.add('translate-x-[-100%]');
          panel.classList.remove('translate-x-0');
          setTimeout(() => {
            drawer.classList.add('hidden');
            document.body.style.overflow = '';
          }, 300);
        }

        openBtn.addEventListener('click', openDrawer);
        closeBtn.addEventListener('click', closeDrawer);
        backdrop.addEventListener('click', closeDrawer);
        drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', closeDrawer));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !drawer.classList.contains('hidden')) closeDrawer();
        });
      })();
    </script>
  </body>
</html>
