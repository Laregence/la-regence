---
import SidebarLayout from "../layouts/SidebarLayout.astro";

const title = "Réservation — La Régence";
const description =
  "Demande de réservation à La Régence, bar-brasserie à Mont-de-Marsan.";
---

<SidebarLayout {title} {description} active="reservation">
  <section
    class="min-h-screen w-full bg-[var(--color-bg)] px-5 py-6 md:px-6 md:py-3"
  >
    <div class="max-w-4xl ml-auto text-right md:pr-8">

      <!-- INTRO -->
      <div id="booking-intro">
        <h1
          class="font-limelight text-4xl md:text-5xl text-brand tracking-wide uppercase"
        >
          Réservation
        </h1>

        <p class="mt-2 text-sm md:text-base text-slate-700">
          Votre demande sera étudiée par notre équipe. Vous recevrez une confirmation après validation.
        </p>
      </div>


      <!-- RESERVATIONS DESACTIVEES -->
      <div
        id="booking-disabled-box"
        class="hidden rounded-2xl soft-border bg-white/60 p-8 text-right"
      >
        <h2 class="font-limelight text-3xl text-brand uppercase">
          Réservation en ligne indisponible
        </h2>

        <p
          id="booking-disabled-message"
          class="mt-4 text-lg text-slate-700"
        ></p>

        <a
          href="tel:+33558859272"
          class="inline-block mt-6 font-limelight bg-brand text-white px-6 py-3 rounded-xl hover:bg-[var(--color-copper)] transition"
        >
          Appeler La Régence
        </a>
      </div>


      <!-- FORMULAIRE -->
      <form
        id="reservation-form"
        class="mt-5 md:mt-4 space-y-5 md:space-y-3 text-left"
      >

        <!-- DATE / SERVICE / HEURE / PERSONNES -->
        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-4 md:gap-y-2"
        >

          <!-- DATE -->
          <label class="block">
            <span class="text-xs md:text-sm uppercase text-slate-600">
              Date
            </span>

            <input
              type="date"
              name="date_service"
              required
              class="mt-1 w-full rounded-xl border border-brand/20 bg-white/60 px-4 py-2 md:py-2"
            />

            <p
              id="date-message"
              class="mt-1 text-xs text-red-700"
            ></p>
          </label>


          <!-- SERVICE -->
          <label class="block">
            <span class="text-xs md:text-sm uppercase text-slate-600">
              Service
            </span>

            <select
              name="service"
              id="service"
              required
              class="mt-1 w-full rounded-xl border border-brand/20 bg-white/60 px-4 py-2 md:py-2"
            >
              <option value="">Choisir</option>
              <option value="midi">Midi</option>
              <option value="soir">Soir</option>
            </select>
          </label>


          <!-- HEURE -->
          <label class="block">
            <span class="text-xs md:text-sm uppercase text-slate-600">
              Heure
            </span>

            <select
              name="heure"
              id="heure"
              required
              class="mt-1 w-full rounded-xl border border-brand/20 bg-white/60 px-4 py-2 md:py-2"
            >
              <option value="">
                Choisissez d’abord un service
              </option>
            </select>
          </label>


          <!-- PERSONNES -->
          <label class="block">
            <span class="text-xs md:text-sm uppercase text-slate-600">
              Nombre de personnes
            </span>

            <input
              type="number"
              name="nb_personnes"
              min="1"
              required
              class="mt-1 w-full rounded-xl border border-brand/20 bg-white/60 px-4 py-2 md:py-2"
            />

            <p class="mt-1 text-xs text-brand/70">
              Réservation confirmée après validation par notre équipe.
            </p>
          </label>

        </div>


        <!-- SALLE + COMMENTAIRE -->
        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-x-4 gap-y-4 md:gap-y-2"
        >

          <!-- SALLE -->
          <label class="block">
            <span class="text-xs md:text-sm uppercase text-slate-600">
              Préférence de salle
            </span>

            <select
              name="preference_salle"
              required
              class="mt-1 w-full rounded-xl border border-brand/20 bg-white/60 px-4 py-2 md:py-2"
            >
              <option value="peu_importe">
                Peu importe
              </option>

              <option value="salle_bas">
                Salle du bas
              </option>

              <option value="etage">
                Étage
              </option>

              <option value="terrasse">
                Terrasse
              </option>
            </select>
          </label>


          <!-- COMMENTAIRE -->
          <label class="block">
            <span class="text-xs md:text-sm uppercase text-slate-600">
              Commentaire
            </span>

            <textarea
              name="commentaire_client"
              rows="2"
              class="mt-1 w-full rounded-xl border border-brand/20 bg-white/60 px-4 py-2 resize-none"
              placeholder="Allergie, poussette, demande particulière..."
            ></textarea>
          </label>

        </div>


        <!-- COORDONNEES -->
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-3 gap-y-4 md:gap-y-2"
        >

          <!-- NOM -->
          <label class="block">
            <span class="text-xs md:text-sm uppercase text-slate-600">
              Nom
            </span>

            <input
              type="text"
              name="nom"
              required
              class="mt-1 w-full rounded-xl border border-brand/20 bg-white/60 px-3 py-2"
            />
          </label>


          <!-- PRENOM -->
          <label class="block">
            <span class="text-xs md:text-sm uppercase text-slate-600">
              Prénom
            </span>

            <input
              type="text"
              name="prenom"
              class="mt-1 w-full rounded-xl border border-brand/20 bg-white/60 px-3 py-2"
            />
          </label>


          <!-- TELEPHONE -->
          <label class="block">
            <span class="text-xs md:text-sm uppercase text-slate-600">
              Téléphone
            </span>

            <input
              type="tel"
              name="telephone"
              required
              class="mt-1 w-full rounded-xl border border-brand/20 bg-white/60 px-3 py-2"
            />
          </label>


          <!-- EMAIL -->
          <label class="block">
            <span class="text-xs md:text-sm uppercase text-slate-600">
              Email
            </span>

            <input
              type="email"
              name="email"
              required
              class="mt-1 w-full rounded-xl border border-brand/20 bg-white/60 px-3 py-2"
            />
          </label>

        </div>


        <!-- MARKETING + BOUTON -->
        <div
          class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 md:gap-6"
        >

          <label
            class="flex items-start gap-2 cursor-pointer md:max-w-[70%]"
          >

            <input
              type="checkbox"
              id="marketing_email"
              name="marketing_email"
              class="mt-1"
            />

            <span class="text-xs md:text-sm text-slate-700">
              J’accepte de recevoir occasionnellement par email les actualités
              et événements de
              <span translate="no" class="notranslate">
                La Régence
              </span>.

              <span class="block text-[11px] md:text-xs text-slate-500 mt-0.5">
                Réveillon, Saint-Valentin, Fêtes de la Madeleine, concerts,
                stand-up et événements spéciaux. Désinscription possible à tout moment.
              </span>
            </span>

          </label>


          <button
            type="submit"
            id="submit-btn"
            class="shrink-0 font-limelight bg-brand text-white px-6 py-2.5 rounded-xl hover:bg-[var(--color-copper)] transition"
          >
            Envoyer ma demande
          </button>

        </div>


        <p
          id="form-message"
          class="text-right text-sm"
        ></p>

      </form>

    </div>
  </section>


  <script>
    import { supabase } from "../lib/supabaseClient.js";


    const bookingDisabledBox =
      document.getElementById("booking-disabled-box");

    const bookingDisabledMessage =
      document.getElementById("booking-disabled-message");

    const form =
      document.getElementById("reservation-form");

    const serviceSelect =
      document.getElementById("service");

    const heureSelect =
      document.getElementById("heure");

    const message =
      document.getElementById("form-message");

    const submitBtn =
      document.getElementById("submit-btn");

    const dateMessage =
      document.getElementById("date-message");

    const bookingIntro =
      document.getElementById("booking-intro");


    const horaires = {

      midi: [
        "12:00",
        "12:15",
        "12:30",
        "12:45",
        "13:00",
        "13:15",
        "13:30",
      ],

      soir: [
        "19:00",
        "19:15",
        "19:30",
        "19:45",
        "20:00",
        "20:15",
        "20:30",
        "20:45",
        "21:00",
        "21:15",
        "21:30",
      ],
    };


    /*
     * CALENDRIER
     * Minimum : aujourd'hui
     * Maximum : aujourd'hui + 2 ans
     */

    const dateInput =
      form?.querySelector('input[name="date_service"]');

    let maxReservationDate = "";


    if (dateInput) {

      const todayDate =
        new Date();


      /*
       * On construit la date locale afin d'éviter
       * un éventuel décalage UTC autour de minuit.
       */

      const formatLocalDate = (date) => {

        const year =
          date.getFullYear();

        const month =
          String(
            date.getMonth() + 1
          ).padStart(2, "0");

        const day =
          String(
            date.getDate()
          ).padStart(2, "0");

        return `${year}-${month}-${day}`;
      };


      const minDate =
        formatLocalDate(todayDate);


      const maxDateObj =
        new Date(todayDate);

      maxDateObj.setFullYear(
        maxDateObj.getFullYear() + 2
      );


      maxReservationDate =
        formatLocalDate(maxDateObj);


      dateInput.setAttribute(
        "min",
        minDate
      );

      dateInput.setAttribute(
        "max",
        maxReservationDate
      );
    }


    /*
     * ACTIVATION / DESACTIVATION
     * DES RESERVATIONS EN LIGNE
     */

    async function checkBookingAvailability() {

      const { data, error } =
        await supabase
          .from("reservation_settings")
          .select("*")
          .eq("key", "online_booking")
          .single();


      if (error) {

        console.error(
          "Erreur réglage réservation :",
          error
        );

        return;
      }


      const value =
        data?.value || {};


      if (value.enabled === false) {

        bookingDisabledMessage.textContent =
          value.message ||
          "La réservation en ligne est actuellement en maintenance. Veuillez nous appeler au 05 58 85 92 72 pour toute réservation. Merci.";


        bookingDisabledBox.classList.remove(
          "hidden"
        );

        form.classList.add(
          "hidden"
        );

        bookingIntro?.classList.add(
          "hidden"
        );

      } else {

        bookingDisabledBox.classList.add(
          "hidden"
        );

        form.classList.remove(
          "hidden"
        );

        bookingIntro?.classList.remove(
          "hidden"
        );
      }
    }


    /*
     * HORAIRES
     */

    function updateHeures() {

      const service =
        serviceSelect?.value;


      if (!heureSelect) return;


      heureSelect.innerHTML = "";


      if (
        !service ||
        !horaires[service]
      ) {

        heureSelect.innerHTML =
          '<option value="">Choisissez d’abord un service</option>';

        return;
      }


      heureSelect.innerHTML =
        '<option value="">Choisir une heure</option>';


      horaires[service].forEach(
        (h) => {

          if (
            isToday(dateInput?.value) &&
            isPastSlot(h)
          ) {
            return;
          }


          const option =
            document.createElement(
              "option"
            );


          option.value = h;

          option.textContent =
            h.replace(":", "h");


          heureSelect.appendChild(
            option
          );
        }
      );
    }


    /*
     * EXCEPTIONS
     */

    let reservationExceptions = [];


    async function loadReservationExceptions() {

      const { data, error } =
        await supabase
          .from("reservation_exceptions")
          .select("*");


      if (error) {

        console.error(
          "Erreur chargement exceptions :",
          error
        );

        reservationExceptions = [];

        return;
      }


      reservationExceptions =
        data || [];


      validateDateSelection();
    }


    function getExceptionForDate(
      dateStr
    ) {

      return reservationExceptions.find(
        (e) =>
          e.date_service === dateStr
      );
    }


    /*
     * EVENEMENTS SERVICE
     */

    serviceSelect?.addEventListener(
      "change",
      () => {

        updateHeures();

        validateDateSelection();
      }
    );


    serviceSelect?.addEventListener(
      "input",
      () => {

        updateHeures();

        validateDateSelection();
      }
    );


    /*
     * OUTILS DATE
     */

    function isSunday(dateStr) {

      if (!dateStr) {
        return false;
      }


      const date =
        new Date(
          dateStr + "T00:00:00"
        );


      return (
        date.getDay() === 0
      );
    }


    function isToday(dateStr) {

      if (!dateStr) {
        return false;
      }


      const today =
        new Date();


      const selected =
        new Date(
          dateStr + "T00:00:00"
        );


      return (

        selected.getFullYear() ===
          today.getFullYear() &&

        selected.getMonth() ===
          today.getMonth() &&

        selected.getDate() ===
          today.getDate()

      );
    }


    function isPastSlot(heure) {

      if (!heure) {
        return true;
      }


      const now =
        new Date();


      const [hour, minute] =
        heure
          .split(":")
          .map(Number);


      if (
        hour < now.getHours()
      ) {
        return true;
      }


      if (
        hour === now.getHours() &&
        minute <= now.getMinutes()
      ) {
        return true;
      }


      return false;
    }


    function isAfterMidiCutoff() {

      const now =
        new Date();


      return (

        now.getHours() > 13 ||

        (
          now.getHours() === 13 &&
          now.getMinutes() >= 30
        )

      );
    }


    function isAfterSoirCutoff() {

      const now =
        new Date();


      return (

        now.getHours() > 21 ||

        (
          now.getHours() === 21 &&
          now.getMinutes() >= 30
        )

      );
    }


    /*
     * VALIDATION DATE
     */

    function validateDateSelection() {

      const selectedDate =
        dateInput?.value;


      const selectedService =
        serviceSelect?.value;


      const exception =
        getExceptionForDate(
          selectedDate
        );


      if (
        !dateMessage ||
        !submitBtn
      ) {
        return true;
      }


      dateMessage.textContent = "";

      submitBtn.disabled = false;


      /*
       * LIMITE +2 ANS
       */

      if (
        selectedDate &&
        maxReservationDate &&
        selectedDate > maxReservationDate
      ) {

        dateMessage.textContent =
          "Les réservations sont ouvertes jusqu’à 2 ans à l’avance. Après, on préfère laisser un peu de suspense 😉";


        submitBtn.disabled = true;

        return false;
      }


      let midiOuvert =
        !isSunday(
          selectedDate
        );


      let soirOuvert =
        !isSunday(
          selectedDate
        );


      if (exception) {

        midiOuvert =
          exception.midi_ouvert;

        soirOuvert =
          exception.soir_ouvert;
      }


      /*
       * MIDI FERME
       */

      if (
        selectedService === "midi" &&
        !midiOuvert
      ) {

        dateMessage.textContent =
          exception?.raison ||
          "Les réservations du midi sont fermées ce jour-là. Merci de nous appeler au 05 58 85 92 72.";


        submitBtn.disabled = true;

        return false;
      }


      /*
       * SOIR FERME
       */

      if (
        selectedService === "soir" &&
        !soirOuvert
      ) {

        dateMessage.textContent =
          exception?.raison ||
          "Les réservations du soir sont fermées ce jour-là. Merci de nous appeler au 05 58 85 92 72.";


        submitBtn.disabled = true;

        return false;
      }


      /*
       * DIMANCHE
       */

      if (
        !selectedService &&
        isSunday(selectedDate) &&
        !exception
      ) {

        dateMessage.textContent =
          "Le restaurant est fermé le dimanche. Pour une demande particulière, merci de nous appeler au 05 58 85 92 72.";


        submitBtn.disabled = true;

        return false;
      }


      /*
       * MIDI DU JOUR
       */

      if (
        selectedService === "midi" &&
        isToday(selectedDate) &&
        isAfterMidiCutoff()
      ) {

        dateMessage.textContent =
          "Les réservations pour ce midi sont désormais fermées. Merci de nous appeler au 05 58 85 92 72.";


        submitBtn.disabled = true;

        return false;
      }


      /*
       * SOIR DU JOUR
       */

      if (
        selectedService === "soir" &&
        isToday(selectedDate) &&
        isAfterSoirCutoff()
      ) {

        dateMessage.textContent =
          "Les réservations pour ce soir sont désormais fermées. Merci de nous appeler au 05 58 85 92 72.";


        submitBtn.disabled = true;

        return false;
      }


      return true;
    }


    /*
     * EVENEMENTS DATE
     */

    dateInput?.addEventListener(
      "input",
      () => {

        updateHeures();

        validateDateSelection();
      }
    );


    dateInput?.addEventListener(
      "change",
      () => {

        updateHeures();

        validateDateSelection();
      }
    );


    /*
     * INITIALISATION
     */

    checkBookingAvailability();

    updateHeures();

    loadReservationExceptions();


    /*
     * ENVOI DU FORMULAIRE
     */

    form?.addEventListener(
      "submit",
      async (event) => {

        event.preventDefault();


        if (
          !validateDateSelection()
        ) {
          return;
        }


        message.textContent = "";

        message.className =
          "text-right text-sm";


        submitBtn.disabled = true;

        submitBtn.textContent =
          "Envoi en cours...";


        const formData =
          new FormData(form);


        const reservation = {

          date_service:
            formData.get(
              "date_service"
            ),

          service:
            formData.get(
              "service"
            ),

          heure:
            formData.get(
              "heure"
            ),

          nb_personnes:
            Number(
              formData.get(
                "nb_personnes"
              )
            ),

          nom:
            String(
              formData.get(
                "nom"
              ) || ""
            ).trim(),

          prenom:
            String(
              formData.get(
                "prenom"
              ) || ""
            ).trim(),

          telephone:
            String(
              formData.get(
                "telephone"
              ) || ""
            ).trim(),

          email:
            String(
              formData.get(
                "email"
              ) || ""
            ).trim(),

          preference_salle:
            formData.get(
              "preference_salle"
            ),

          commentaire_client:
            String(
              formData.get(
                "commentaire_client"
              ) || ""
            ).trim(),

          marketing_email:
            formData.get(
              "marketing_email"
            ) === "on",

          origine:
            "site",

          statut:
            "nouvelle",

          a_traiter:
            true,
        };


        /*
         * CREATION RESERVATION
         */

        const createResponse =
          await fetch(
            "/.netlify/functions/create-reservation",
            {

              method:
                "POST",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body:
                JSON.stringify(
                  reservation
                ),
            }
          );


        const createResult =
          await createResponse.json();


        if (!createResponse.ok) {

          console.error(
            "Erreur création réservation :",
            createResult
          );


          message.textContent =
            "Erreur Supabase : " +
            (
              createResult.error ||
              "Erreur inconnue"
            );


          message.classList.add(
            "text-red-700"
          );


          submitBtn.disabled =
            false;


          submitBtn.textContent =
            "Envoyer ma demande";


          return;
        }


        const data =
          createResult.reservation;


        /*
         * EMAIL ADMIN
         */

        try {

          const emailResponse =
            await fetch(
              "/.netlify/functions/send-reservation-email",
              {

                method:
                  "POST",

                headers: {
                  "Content-Type":
                    "application/json",
                },

                body:
                  JSON.stringify({

                    type:
                      "new_reservation_admin",

                    reservation:
                      data,
                  }),
              }
            );


          const emailResult =
            await emailResponse.json();


          console.log(
            "Réponse fonction email :",
            emailResult
          );


          if (!emailResponse.ok) {

            console.error(
              "Erreur fonction email :",
              emailResult
            );


            alert(
              "Réservation enregistrée, mais mail non envoyé : " +
              (
                emailResult.error ||
                "erreur inconnue"
              )
            );
          }


        } catch (emailError) {

          console.error(
            "Erreur envoi mail admin :",
            emailError
          );


          alert(
            "Réservation enregistrée, mais erreur mail."
          );
        }


        /*
         * NOTIFICATION PUSH
         */

        try {

          const pushDate =
            new Date(
              data.date_service +
              "T00:00:00"
            ).toLocaleDateString(
              "fr-FR",
              {

                weekday:
                  "long",

                day:
                  "numeric",

                month:
                  "long",
              }
            );


          const pushNom =
            `${data.nom || ""} ${data.prenom || ""}`.trim();


          await fetch(
            "/.netlify/functions/send-push-notification",
            {

              method:
                "POST",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body:
                JSON.stringify({

                  title:
                    `Nouvelle réservation — ${pushNom || "Client"}`,

                  body:
                    `${data.nb_personnes} pers. — ${pushDate} — ${String(data.heure).slice(0, 5).replace(":", "h")}`,

                  url:
                    "/admin/reservations",
                }),
            }
          );


        } catch (pushError) {

          console.error(
            "Erreur notification push :",
            pushError
          );
        }


        /*
         * SUCCES
         */

        form.reset();


        heureSelect.innerHTML =
          '<option value="">Choisissez d’abord un service</option>';


        message.textContent =
          "Votre demande de réservation a bien été envoyée. Nous reviendrons vers vous pour confirmation.";


        message.classList.add(
          "text-green-700"
        );


        submitBtn.disabled =
          false;


        submitBtn.textContent =
          "Envoyer ma demande";
      }
    );
  </script>
</SidebarLayout>