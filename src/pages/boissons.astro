---

<SidebarLayout {title} {description} active="boissons">
  <section class="min-h-screen w-full bg-[var(--color-bg)] px-6 py-10">
    <div class="max-w-[1400px] ml-auto text-right md:pr-12">

      <h1 class="font-limelight text-5xl text-brand tracking-wide uppercase">Boissons</h1>

      <!-- Barre d'onglets -->
      <nav class="sticky top-24 md:top-0 z-30 bg-[var(--color-bg)]/95 supports-[backdrop-filter]:backdrop-blur border-b border-brand/15">
        <div class="max-w-5xl ml-auto md:pr-12 px-2">
          <ul id="tabsWrap" class="flex justify-start items-center gap-4 whitespace-nowrap overflow-x-auto py-2 no-scrollbar scroll-smooth">
            {sections.map((s) => (
              <li><a href={`#${s.id}`} class="tab-link font-limelight text-brand hover:text-[var(--color-copper)] transition" data-tab={s.id}>{s.tab}</a></li>
            ))}
          </ul>
        </div>
      </nav>

      {sections.map((s, i) => (
        <>
          {i > 0 && (
            <div class="my-8 grid grid-cols-1 md:grid-cols-[360px_1fr] items-center">
              <div class="hidden md:block"></div>
              <div class="h-[2px] w-[min(560px,90%)] ml-auto bg-[var(--color-copper)]"></div>
            </div>
          )}
          <section
            id={s.id}
            class="relative grid grid-cols-1 lg:grid-cols-[360px_1fr] gap-6 lg:items-start scroll-mt-[calc(6rem+2.75rem)] md:scroll-mt-16"
          >
            <figure class="hidden lg:block">
              <img src={s.img} alt={`${s.titre} — La Régence`} class="w-[360px] h-[546px] object-cover rounded-2xl soft-border" />
            </figure>

            <div class="md:max-w-[560px] md:ml-auto w-full text-right">
              <h2
                class="sticky top-[calc(6rem+2.5rem)] md:top-[2.75rem] z-20
                       bg-[var(--color-bg)]/95 supports-[backdrop-filter]:backdrop-blur
                       border-b border-brand/10
                       font-limelight text-3xl text-brand uppercase py-2"
              >
                {s.titre}
              </h2>

              {s.intro && <p class="text-sm text-slate-600 mt-2">{s.intro}</p>}

              {s.groupes.map((g) => (
                <>
                  {g.titre && (
                    <div class="mt-6 flex items-baseline justify-end gap-6">
                      <h3 class="flex-1 text-sm tracking-wide text-slate-600 uppercase">{g.titre}</h3>
                      {g.colonnes && g.colonnes.map((c) => (
                        <span class="w-[4.5rem] text-xs text-slate-500">{c}</span>
                      ))}
                    </div>
                  )}
                  <div class={`${g.titre ? "mt-2" : "mt-4"} space-y-3 text-slate-800`}>
                    {g.items.map((it) => (
                      <div class="flex items-baseline justify-end gap-6">
                        <div class="flex-1 text-right">
                          <p translate="no" class="notranslate uppercase">{it.nom}</p>
                          {it.desc && <p class="text-sm text-slate-600">{it.desc}</p>}
                        </div>
                        {Array.isArray(it.prix)
                          ? it.prix.map((p) => <div class="w-[4.5rem] text-right font-medium whitespace-nowrap">{fmt(p)}</div>)
                          : <div class="text-right font-medium whitespace-nowrap">{fmt(it.prix)}</div>}
                      </div>
                    ))}
                  </div>
                  {g.note && <p class="text-sm text-slate-600 mt-3">{g.note}</p>}
                </>
              ))}

              {s.outro && <p class="mt-6 text-sm text-slate-600">{s.outro}</p>}
            </div>
          </section>
        </>
      ))}

      <p class="mt-10 text-sm text-slate-500">Prix en euros, net & TTC, service inclus. L'abus d'alcool est dangereux pour la santé, à consommer avec modération.</p>

    </div>
  </section>

  <!-- Photos regroupées en bas (mobile / tablette) -->
  <div class="mt-10 -mx-6 sm:mx-0 grid grid-cols-1 sm:grid-cols-2 gap-0 sm:gap-4 lg:hidden">
    {sections.map((s) => (
      <img src={s.img} alt={`${s.titre} — La Régence`} loading="lazy" decoding="async" class="w-full h-auto object-cover rounded-none sm:rounded-2xl" />
    ))}
  </div>

  <!-- Tabs actifs au scroll + au clic -->
  <script is:inline>
    (function () {
      const tabsWrap = document.getElementById('tabsWrap');
      const tabs = Array.from(document.querySelectorAll('.tab-link'));
      const secs = tabs.map(a => document.getElementById(a.dataset.tab)).filter(Boolean);
      if (!tabs.length || !secs.length) return;

      const setActive = (id) => {
        tabs.forEach(a => {
          const active = a.dataset.tab === id;
          a.classList.toggle('text-[var(--color-copper)]', active);
          a.classList.toggle('text-brand', !active);
        });
      };

      const scrollTabIntoLeft = (linkEl) => {
        if (!tabsWrap || !linkEl) return;
        tabsWrap.scrollTo({ left: Math.max(0, linkEl.offsetLeft - 12), behavior: 'smooth' });
      };

      const initialId = (location.hash || '').replace('#', '') || tabs[0].dataset.tab;
      setActive(initialId);
      const initialLink = tabs.find(a => a.dataset.tab === initialId);
      if (initialLink) requestAnimationFrame(() => scrollTabIntoLeft(initialLink));

      const io = new IntersectionObserver((entries) => {
        const vis = entries.filter(e => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!vis) return;
        setActive(vis.target.id);
        const link = tabs.find(a => a.dataset.tab === vis.target.id);
        if (link) scrollTabIntoLeft(link);
      }, { root: null, rootMargin: '-45% 0px -45% 0px', threshold: [0.01, 0.1, 0.25, 0.5] });

      secs.forEach(s => io.observe(s));
      tabs.forEach(a => a.addEventListener('click', () => { setActive(a.dataset.tab); scrollTabIntoLeft(a); }));
    })();
  </script>
</SidebarLayout>
