---
import SidebarLayout from "../layouts/SidebarLayout.astro";
import PromoPopup from "../components/PromoPopup.astro";
import { execSync } from "node:child_process";

const title = "Restaurant & brasserie à Mont-de-Marsan | La Régence";
const description = "La Régence, restaurant brasserie au centre-ville de Mont-de-Marsan : menu du midi, cuisine généreuse, tapas, cocktails, bières pression et vins.";
const menuFile = "public/menu-du-jour.png";

// Format FR affiché
function formatDateFR(date) {
  const str = date.toLocaleDateString("fr-FR", {
    weekday: "long",
    day: "numeric",
    month: "long",
  });

  return str.charAt(0).toUpperCase() + str.slice(1);
}

function getMenuGitDate() {
  try {
    const gitDate = execSync(
      `git log -1 --format=%cI -- "${menuFile}"`,
      { encoding: "utf-8" }
    ).trim();

    if (!gitDate) throw new Error("No git date found");
    return gitDate;
  } catch {
    return new Date().toISOString();
  }
}

const menuGitDate = getMenuGitDate();
const menuDate = formatDateFR(new Date(menuGitDate));
const menuImage = `/menu-du-jour.png?v=${encodeURIComponent(menuGitDate)}`;
const restaurantSchema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "@id": "https://laregencemdm.fr/#restaurant",
  "name": "La Régence",
  "url": "https://laregencemdm.fr/",
  "logo": "https://laregencemdm.fr/logo.png",
  "telephone": "+33558859272",
  "image": [
    "https://laregencemdm.fr/contact-grande.jpg",
    "https://laregencemdm.fr/contact-petite.jpg"
  ],
  "description": "La Régence est un restaurant brasserie situé en centre-ville de Mont-de-Marsan. Cuisine de brasserie, menu du midi, tapas, cocktails, bières pression et vins du lundi au samedi.",
  "servesCuisine": [
    "Cuisine française",
    "Brasserie",
    "Tapas"
  ],
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "2 rue Léon Gambetta",
    "postalCode": "40000",
    "addressLocality": "Mont-de-Marsan",
    "addressCountry": "FR"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
      ],
      "opens": "07:30",
      "closes": "00:00"
    }
  ],
  "menu": "https://laregencemdm.fr/menu/",
  "acceptsReservations": true,
  "sameAs": [
    "https://www.instagram.com/la_regence_mdm/",
    "https://www.facebook.com/LaRegenceMDM/"
  ]
};
---

<SidebarLayout {title} {description} active="accueil">
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(restaurantSchema)}
  ></script>


  <!-- ========= SPLASH ========= -->
  <div
    id="splash"
    class="fixed inset-0 z-50 bg-brand text-[var(--color-bg)]
           flex flex-col items-center justify-center
           transform-gpu translate-y-0 transition-transform duration-[1800ms] ease-out"
  >
    <div class="absolute left-0 right-0" style="top:90%; height:3px; background:#a3742c;"></div>

    <div class="absolute w-full text-center text-sm opacity-80 flex flex-col items-center" style="top:92%;">
      <img src="/logo.png" alt="La Régence" class="w-6 h-6 mb-1 opacity-90" />
      <p>© <span translate="no" class="notranslate">La Régence</span> 2026</p>
    </div>

    <div class="flex flex-col items-center gap-5 font-splash fade-in-contents">
      <img 
        src="/logo.png" 
        alt="La Régence" 
        class="w-60 h-60 md:w-72 md:h-72 lg:w-80 lg:h-80 object-contain" 
      />
      <p class="text-2xl md:text-3xl text-center">
        Restaurant & Brasserie à Mont-de-Marsan
      </p>
    </div>
  </div>

  <!-- ========= CONTENU ========= -->
  <div id="page-wrap">

    <!-- ===== MOBILE : images plein écran, sans bord ni recadrage ===== -->
    <div class="md:hidden relative left-1/2 w-screen -translate-x-1/2 -mt-24 overflow-x-hidden">

      <!-- 1. Grande image -->
      <img
        src="/grande.jpg"
        alt="Salle du restaurant La Régence à Mont-de-Marsan"
        class="block w-full h-auto object-contain"
      />

      <!-- 2. Texte -->
      <section class="w-full px-6 py-10 text-center font-nour">
        <h1 class="text-[12px] font-semibold uppercase tracking-[0.22em] text-brand leading-relaxed">
          Restaurant brasserie<br /><span class="whitespace-nowrap">Mont-de-Marsan</span>
        </h1>
        <p translate="no" class="notranslate mt-2 font-limelight text-4xl leading-none text-brand">
          La Régence
        </p>

        <p class="mt-6 text-[15px] leading-[1.75] tracking-[0.02em] text-[#3b4239]">
          Au cœur de Mont-de-Marsan, là où le Midou et la Douze se rejoignent,
          <span translate="no" class="notranslate">La Régence</span> accueille les Montois depuis 1988.
          Une cuisine de brasserie généreuse, préparée sur place avec des produits frais&nbsp;:
          menu du jour le midi, tapas, cocktails et vins le soir, du lundi au samedi.
        </p>

        <p class="mt-6 text-[15px] tracking-[0.02em] text-[#3b4239]">
          Réservez votre table
          <a href="/reservation/" class="font-semibold text-[var(--color-copper)]">en ligne</a>
          ou au
          <a href="tel:+33558859272" class="font-semibold text-[var(--color-copper)] whitespace-nowrap">05&nbsp;58&nbsp;85&nbsp;92&nbsp;72</a>
        </p>

        <p class="mt-4 text-[13px] tracking-[0.06em] text-[#6b6b62]">
          <span class="text-[var(--color-copper)] tracking-[0.12em]">★★★★★</span>&nbsp;
          Avis Google ·
          <button type="button" class="js-open-reviews underline underline-offset-4">voir les avis</button>
        </p>
      </section>

      <!-- 3. Menu du jour : image entière, cliquable -->
      <button
        type="button"
        class="js-menu-thumb block w-full m-0 p-0 border-0 bg-transparent cursor-pointer"
        data-img={menuImage}
        aria-label={`Ouvrir le menu du ${menuDate}`}
      >
        <img
          src={menuImage}
          alt={`Menu du ${menuDate}`}
          class="block w-full h-auto object-contain"
        />
      </button>

      <!-- 4. Petite image -->
      <img
        src="/petite2.jpg"
        alt="Ambiance de La Régence, restaurant brasserie à Mont-de-Marsan"
        class="block w-full h-auto object-contain"
      />
    </div>

    <!-- ===== TABLETTE / DESKTOP : mise en page actuelle conservée ===== -->
    <section class="hidden md:block w-full md:h-[calc(100dvh-24px)] px-0 py-3 overflow-hidden">

      <div class="grid h-full grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-3 xl:gap-4">

        <!-- ===== TEXTE ===== -->
        <div class="min-h-0 flex">
          <div class="w-full text-right font-nour flex flex-col justify-end pb-10 pr-8 xl:pr-14 pl-6 xl:pl-24">

            <h2 class="text-[13px] font-semibold uppercase tracking-[0.22em] text-brand">
              Restaurant brasserie · Mont-de-Marsan
            </h2>
            <p translate="no" class="notranslate mt-2.5 font-limelight text-[44px] leading-none text-brand">
              La Régence
            </p>

            <p class="mt-6 text-[15px] leading-[1.75] tracking-[0.03em] text-[#3b4239]">
              Au cœur de Mont-de-Marsan, là où le Midou et la Douze se rejoignent,
              <span translate="no" class="notranslate">La Régence</span> accueille les Montois depuis 1988.
              Une cuisine de brasserie généreuse, préparée sur place avec des produits frais&nbsp;:
              menu du jour le midi, tapas, cocktails et vins le soir, du lundi au samedi.
            </p>

            <p class="mt-7 text-[15px] tracking-[0.03em] text-[#3b4239]">
              Réservez votre table
              <a href="/reservation/" class="font-semibold text-[var(--color-copper)] hover:text-brand transition-colors">en ligne</a>
              ou au
              <a href="tel:+33558859272" class="font-semibold text-[var(--color-copper)] hover:text-brand transition-colors whitespace-nowrap">05&nbsp;58&nbsp;85&nbsp;92&nbsp;72</a>
            </p>

            <p class="mt-5 text-[13px] tracking-[0.06em] text-[#6b6b62]">
              <span class="text-[var(--color-copper)] tracking-[0.12em]">★★★★★</span>&nbsp;
              Avis Google ·
              <button type="button" class="js-open-reviews underline-offset-4 hover:underline hover:text-brand transition-colors">voir les avis</button>
            </p>

          </div>
        </div>

        <!-- ===== IMAGES ===== -->
        <div class="min-h-0 md:min-w-0 md:overflow-hidden">

          <div class="hidden md:grid md:gap-6 md:grid-cols-1 xl:grid-cols-3 xl:grid-rows-10 md:h-full">

            <!-- Grande image -->
            <div class="relative xl:col-span-2 xl:row-span-10 rounded-2xl overflow-hidden">
              <img
                src="/grande.jpg"
                alt="Salle du restaurant La Régence à Mont-de-Marsan"
                class="w-full md:h-[60vh] xl:h-full object-cover"
              />

              <!-- Pastilles sur la grande photo : menu du jour + « En ce moment » (déplacée ici par PromoPopup) -->
              <div id="pill-dock" class="absolute left-4 right-4 bottom-4 flex flex-wrap items-center gap-3">
              <button
                type="button"
                class="js-menu-thumb flex items-center gap-3 rounded-full
                       bg-[var(--color-bg)] border-[1.5px] border-[var(--color-copper)] py-2 pl-2 pr-5
                       shadow-lg font-nour text-left hover:scale-105 transition"
                data-img={menuImage}
                aria-label={`Voir le menu du ${menuDate}`}
              >
                <span class="w-9 h-9 rounded-full bg-brand flex items-center justify-center shrink-0">
                  <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="none" stroke="#c9974a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 3v8a3 3 0 0 0 3 3v7M8 3v6M11 3v8a3 3 0 0 1-3 3M17 21V3c-2 1.5-3 4-3 7v4h3"/>
                  </svg>
                </span>
                <span>
                  <span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--color-copper)]">{menuDate}</span>
                  <span class="block text-sm font-semibold text-brand">Menu du jour</span>
                </span>
              </button>
              </div>
            </div>

            <div class="hidden xl:block xl:col-span-1 xl:row-span-2"></div>

            <!-- Photo repas -->
            <div class="rounded-2xl overflow-hidden xl:col-span-1 xl:row-span-4">
              <img
                src="/La Régence-17.jpg"
                alt="Repas partagé à La Régence, restaurant brasserie à Mont-de-Marsan"
                class="w-full md:h-[28vh] xl:h-full object-cover"
              />
            </div>

            <!-- Petite image -->
            <div class="rounded-2xl overflow-hidden xl:col-span-1 xl:row-span-4">
              <img
                src="/petite2.jpg"
                alt="Ambiance de La Régence, restaurant brasserie à Mont-de-Marsan"
                class="w-full md:h-[28vh] xl:h-full object-cover"
              />
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- POP-UP MISE EN AVANT (géré dans /admin/mises-en-avant) -->
    <PromoPopup />

    <!-- AVIS GOOGLE (fenêtre) -->
    <div id="reviews-modal" class="fixed inset-0 z-[65] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="reviews-title">
      <div class="js-close-reviews absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
      <div class="relative w-full max-w-lg max-h-[85dvh] overflow-y-auto rounded-2xl bg-[var(--color-bg)] p-6 shadow-2xl font-nour">
        <button type="button" class="js-close-reviews absolute right-3 top-3 w-9 h-9 rounded-full text-brand hover:bg-brand/10 text-xl leading-none" aria-label="Fermer">×</button>
        <h2 id="reviews-title" class="font-limelight text-2xl text-brand">Avis Google</h2>
        <div id="reviews-body" class="mt-4 text-left">
          <p class="text-sm text-slate-500">Chargement…</p>
        </div>
      </div>
    </div>

    <!-- LIGHTBOX -->
    <div id="menu-du-jour-lightbox" class="fixed inset-0 hidden items-center justify-center z-[60]">
      <div id="lb-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
      <div id="lb-figure" class="relative">
        <img id="lb-img" src={menuImage} class="max-w-[90vw] max-h-[85vh] rounded-2xl shadow-xl" />
      </div>
    </div>

  </div>

  <!-- SCRIPT LIGHTBOX -->
  <script is:inline>
  // Splash
  (function () {
    const s = document.getElementById('splash');
    if (!s) return;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const go = () => {
      if (prefersReduced) {
        s.remove();
        return;
      }
      s.classList.add('slide-up-out');
      s.addEventListener('transitionend', () => s.remove(), { once: true });
    };

    window.addEventListener('load', () => setTimeout(go, 1500));
  })();

  // Lightbox (multi-vignettes)
  (function () {
    const thumbs   = Array.from(document.querySelectorAll(".js-menu-thumb"));
    const lightbox = document.getElementById("menu-du-jour-lightbox");
    const backdrop = document.getElementById("lb-backdrop");
    const figure   = document.getElementById("lb-figure");
    const img      = document.getElementById("lb-img");
    if (!thumbs.length || !lightbox || !backdrop || !figure || !img) return;

    function openLB(src) {
      if (src) img.src = src;
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      img.style.filter = "none";
      img.style.webkitFilter = "none";
      requestAnimationFrame(() => {
        backdrop.classList.add("opacity-100");
        figure.classList.remove("opacity-0", "scale-95", "translate-y-1");
        figure.classList.add("opacity-100", "scale-100", "translate-y-0");
      });
    }

    function closeLB() {
      figure.classList.add("opacity-0", "scale-95", "translate-y-1");
      figure.classList.remove("opacity-100", "scale-100", "translate-y-0");
      backdrop.classList.remove("opacity-100");
      setTimeout(() => {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
      }, 300);
    }

    thumbs.forEach(t => {
      t.addEventListener("click", () => openLB(t.dataset.img || "/menu-du-jour.png"));
    });

    lightbox.addEventListener("click", (e) => {
      if (e.target === img) return;
      closeLB();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !lightbox.classList.contains("hidden")) closeLB();
    });
  })();

</script>



  <!-- AVIS GOOGLE -->
  <script is:inline>
    (function () {
      const openers = Array.from(document.querySelectorAll(".js-open-reviews"));
      const modal = document.getElementById("reviews-modal");
      const body = document.getElementById("reviews-body");
      if (!openers.length || !modal || !body) return;

      function make(tag, className, text) {
        const el = document.createElement(tag);
        if (className) el.className = className;
        if (typeof text === "string") el.textContent = text;
        return el;
      }

      function stars(rating) {
        const value = Math.max(0, Math.min(5, Math.round(Number(rating) || 0)));
        return "★".repeat(value) + "☆".repeat(5 - value);
      }

      function renderReviews(target, data) {
        target.innerHTML = "";
        target.classList.remove("hidden");

        const summary = make("p", "mb-3 text-sm text-slate-700");
        summary.textContent = `${data.rating ? Number(data.rating).toFixed(1) + "/5" : "—"} · ${Number(data.userRatingCount || 0).toLocaleString("fr-FR")} avis Google`;
        target.appendChild(summary);

        const reviewList = make("div", "space-y-3");

        (data.reviews || []).forEach((review) => {
          const card = make("article", "rounded-xl border border-brand/15 bg-[var(--color-bg)]/70 p-3");

          const author = make("p", "font-semibold text-slate-800", review.author?.name || "Utilisateur Google");
          const starLine = make("div", "mt-1 text-[var(--color-copper)] tracking-wide text-sm", stars(review.rating));
          const body = make("p", "mt-2 text-sm leading-relaxed text-slate-700", review.text || "");

          card.append(author, starLine, body);

          if (review.googleMapsUri) {
            const source = document.createElement("a");
            source.href = review.googleMapsUri;
            source.target = "_blank";
            source.rel = "noopener";
            source.className = "inline-block mt-2 text-xs text-brand underline underline-offset-2";
            source.textContent = "Voir l’avis sur Google Maps";
            card.appendChild(source);
          }

          reviewList.appendChild(card);
        });

        target.appendChild(reviewList);

        if (data.googleMapsUri) {
          const mapsLink = document.createElement("a");
          mapsLink.href = data.googleMapsUri;
          mapsLink.target = "_blank";
          mapsLink.rel = "noopener";
          mapsLink.className = "inline-block mt-4 text-sm font-semibold text-brand underline decoration-[var(--color-copper)] underline-offset-4";
          mapsLink.textContent = "Voir tous les avis sur Google Maps";
          target.appendChild(mapsLink);
        }
      }

      let loadingPromise = null;

      function fetchGoogleReviews() {
        if (!loadingPromise) {
          loadingPromise = fetch("/.netlify/functions/google-reviews", {
            method: "GET",
            cache: "no-store",
          }).then(async (response) => {
            const data = await response.json();
            if (!response.ok) {
              throw new Error(data?.error || "Avis Google indisponibles");
            }
            return data;
          });
        }
        return loadingPromise;
      }

      function closeModal() {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }

      async function openModal() {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        try {
          const data = await fetchGoogleReviews();
          renderReviews(body, data);
        } catch (error) {
          console.error("Avis Google :", error);
          loadingPromise = null;
          body.innerHTML = '<p class="text-sm text-slate-500">Les avis Google sont momentanément indisponibles.</p>';
        }
      }

      openers.forEach((btn) => btn.addEventListener("click", openModal));
      modal.querySelectorAll(".js-close-reviews").forEach((el) => el.addEventListener("click", closeModal));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
      });
    })();
  </script>

</SidebarLayout> 