---
import SidebarLayout from "../layouts/SidebarLayout.astro";
import { execSync } from "node:child_process";

const title = "Restaurant & brasserie à Mont-de-Marsan | La Régence";
const description =
  "La Régence, restaurant brasserie au centre-ville de Mont-de-Marsan : menu du midi, cuisine généreuse, tapas, cocktails, bières pression et vins.";

const menuFile = "public/menu-du-jour.png";
const currentYear = new Date().getFullYear();

// Format FR affiché
function formatDateFR(date) {
  const str = date.toLocaleDateString("fr-FR", {
    weekday: "long",
    day: "numeric",
    month: "long",
  });

  return str.charAt(0).toUpperCase() + str.slice(1);
}

function getMenuGitDate() {
  try {
    const gitDate = execSync(
      `git log -1 --format=%cI -- "${menuFile}"`,
      { encoding: "utf-8" }
    ).trim();

    if (!gitDate) throw new Error("No git date found");
    return gitDate;
  } catch {
    return new Date().toISOString();
  }
}

const menuGitDate = getMenuGitDate();
const menuDate = formatDateFR(new Date(menuGitDate));
const menuImage = `/menu-du-jour.png?v=${encodeURIComponent(menuGitDate)}`;

const restaurantSchema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "@id": "https://laregencemdm.fr/#restaurant",

  "name": "La Régence",
  "url": "https://laregencemdm.fr/",
  "logo": "https://laregencemdm.fr/logo.png",

  "telephone": "+33558859272",

  "image": [
    "https://laregencemdm.fr/grande.jpg",
    "https://laregencemdm.fr/contact-grande.jpg",
    "https://laregencemdm.fr/contact-petite.jpg"
  ],

  "description":
    "La Régence est un restaurant brasserie situé au centre-ville de Mont-de-Marsan. Cuisine de brasserie, menu du midi, tapas, cocktails, bières pression et vins du lundi au samedi.",

  "servesCuisine": [
    "Cuisine française",
    "Brasserie",
    "Tapas"
  ],

  "priceRange": "€€",

  "address": {
    "@type": "PostalAddress",
    "streetAddress": "2 rue Léon Gambetta",
    "postalCode": "40000",
    "addressLocality": "Mont-de-Marsan",
    "addressCountry": "FR"
  },

  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
      ],
      "opens": "07:30",
      "closes": "00:00"
    }
  ],

  "menu": "https://laregencemdm.fr/menu/",
  "acceptsReservations": true,

  "sameAs": [
    "https://www.instagram.com/la_regence_mdm/",
    "https://www.facebook.com/LaRegenceMDM/"
  ]
};
---

<SidebarLayout {title} {description} active="accueil">

  <!-- ========= DONNÉES STRUCTURÉES ========= -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(restaurantSchema)}
  ></script>


  <!-- ========= SPLASH ========= -->
  <div
    id="splash"
    class="fixed inset-0 z-50 bg-brand text-[var(--color-bg)]
           flex flex-col items-center justify-center
           transform-gpu translate-y-0 transition-transform duration-[1800ms] ease-out"
  >
    <div
      class="absolute left-0 right-0"
      style="top:90%; height:3px; background:#a3742c;"
    ></div>

    <div
      class="absolute w-full text-center text-sm opacity-80 flex flex-col items-center"
      style="top:92%;"
    >
      <img
        src="/logo.png"
        alt=""
        width="24"
        height="24"
        class="w-6 h-6 mb-1 opacity-90"
      />

      <p>
        ©
        <span translate="no" class="notranslate">La Régence</span>
        {currentYear}
      </p>
    </div>

    <div class="flex flex-col items-center gap-5 font-splash fade-in-contents">
      <img
        src="/logo.png"
        alt="Logo La Régence"
        class="w-60 h-60 md:w-72 md:h-72 lg:w-80 lg:h-80 object-contain"
      />

      <p class="text-2xl md:text-3xl text-center">
        Restaurant & Brasserie à Mont-de-Marsan
      </p>
    </div>
  </div>


  <!-- ========= CONTENU ========= -->
  <div id="page-wrap">

    <section
      class="w-full md:h-[calc(100dvh-24px)] md:px-0 md:py-3 md:overflow-hidden"
    >

      <div
        class="md:grid md:h-full
               md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]
               md:gap-3 xl:gap-4"
      >


        <!-- ================================================= -->
        <!-- MOBILE : GRANDE IMAGE AVANT LE TEXTE              -->
        <!-- ================================================= -->

        <div
          class="md:hidden relative left-1/2 w-screen
                 -translate-x-1/2 -mt-24 overflow-x-hidden"
        >
          <