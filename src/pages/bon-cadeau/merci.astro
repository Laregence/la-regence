---
import SidebarLayout from "../../layouts/SidebarLayout.astro";

const title = "Merci pour votre bon cadeau — La Régence";
const description = "Votre bon cadeau La Régence a bien été commandé.";
---

<SidebarLayout {title} {description} active="bon-cadeau">
  <section class="min-h-screen w-full bg-[var(--color-bg)] px-5 py-10 md:px-6">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-5xl">🎁</p>
      <h1 class="mt-4 font-limelight text-4xl md:text-5xl text-brand uppercase">Merci !</h1>
      <p class="mt-4 text-lg text-slate-700">
        Votre paiement a bien été reçu. Le bon cadeau est envoyé par email dans quelques instants,
        en pièce jointe au format PDF.
      </p>
      <p class="mt-3 text-slate-600">
        Vous ne le voyez pas ? Pensez à vérifier vos courriers indésirables, ou appelez-nous au
        <a href="tel:+33558859272" class="underline underline-offset-2 text-brand">05&nbsp;58&nbsp;85&nbsp;92&nbsp;72</a>.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="font-limelight border border-brand text-brand px-6 py-3 rounded-xl hover:bg-brand hover:text-white transition">Accueil</a>
        <a href="/bon-cadeau/" class="font-limelight bg-brand text-white px-6 py-3 rounded-xl hover:bg-[var(--color-copper)] transition">Offrir un autre bon</a>
      </div>
    </div>
  </section>
</SidebarLayout>
