---
import SidebarLayout from "../layouts/SidebarLayout.astro";

const title = "La Régence — Le Bar, Le Restaurant, La Terrasse";
const description = "Présentation du Bar & Restaurant La Régence à Mont-de-Marsan.";
---

<SidebarLayout {title} {description} active="la-regence">
  <!-- Conteneur général sur la hauteur de l'écran -->
  <section class="min-h-screen md:h-screen w-[calc(100%+2rem)] sm:w-[calc(100%+3rem)] md:w-full -mx-4 sm:-mx-6 md:mx-0 bg-[var(--color-bg)] px-0 md:px-8 overflow-x-hidden">
    <!-- Wrapper principal : relatif + plein écran -->
    <div class="relative w-full h-full">
      <!-- BARRE D’ONGLETS : fixe visuellement sur desktop, normale sur mobile -->
      <div
        class="fixed top-24 inset-x-0 z-30 h-14
               flex items-center justify-center
               bg-[var(--color-bg)]/95 backdrop-blur
               border-b-2 border-[var(--color-copper)]
               md:absolute md:top-4 md:left-0 md:right-auto md:w-1/2 md:h-auto
               md:block md:bg-transparent md:backdrop-blur-none md:border-b-0
               md:pr-10 md:mb-4"
      >
        <nav class="w-full md:w-auto md:inline-block px-2 md:px-4 py-2 md:rounded-xl bg-[var(--color-bg)]/95">
          <ul
            class="flex justify-center md:justify-start gap-3 sm:gap-5 md:gap-6
                   font-limelight text-base sm:text-lg md:text-2xl tracking-wide text-brand"
          >
            <li>
              <a
                href="#bar"
                class="tab-link text-brand hover:text-[var(--color-copper)] transition"
                data-tab="bar"
              >
                Le Bar
              </a>
            </li>
            <li>
              <a
                href="#restaurant"
                class="tab-link text-brand hover:text-[var(--color-copper)] transition"
                data-tab="restaurant"
              >
                Le Restaurant
              </a>
            </li>
            <li>
              <a
                href="#terrasse"
                class="tab-link text-brand hover:text-[var(--color-copper)] transition"
                data-tab="terrasse"
              >
                La Terrasse
              </a>
            </li>
          </ul>
        </nav>
      </div>

      <!-- CONTENEUR SCROLLABLE + SNAP POUR LES 3 PAGES -->
      <div class="h-full pt-14 md:pt-0 md:overflow-y-scroll md:snap-y md:snap-mandatory">

        <!-- ====== PAGE 1 : LE BAR ====== -->
        <section id="bar" class="md:snap-start md:h-full flex items-stretch relative">
          <!-- Rectangle VERT full hauteur de la page -->
          <div
            aria-hidden="true"
            class="hidden md:block absolute top-0 bottom-0 right-[4vw]
                   w-[min(28vw,500px)] min-w-[300px] bg-brand"
          ></div>

          <div class="w-full flex flex-col md:flex-row md:h-full relative z-10 py-0 md:py-8">
            <!-- COLONNE GAUCHE (texte) : droite + bas -->
            <div class="order-2 md:order-1 md:w-1/2 flex flex-col items-center md:items-end text-center md:text-right justify-end px-6 md:pl-0 md:pr-10 py-10 md:pt-0 md:pb-20">
              <h2 class="font-limelight text-brand text-4xl md:text-6xl leading-none inline-block relative pt-4">
                <span class="absolute top-0 right-0 h-[3px] w-full bg-[var(--color-copper)] rounded-full"></span>
                Le Bar
              </h2>

              <div class="mt-4 text-slate-800 leading-relaxed text-lg">
                <p>
                  Signature cocktails, sélection de bières pression et une carte courte, fraîche et conviviale.
                </p>
                <p class="mt-3">
                  Bois, lumière douce, bar central — un lieu vivant du matin au soir.
                </p>
              </div>
            </div>

            <!-- COLONNE DROITE (images) -->
            <div class="order-1 md:order-2 w-full md:w-1/2 flex items-start gap-4 md:pr-[3vw]">
              <figure class="w-full md:w-[65%] overflow-hidden rounded-none md:rounded-2xl md:soft-border">
                <img
                  src="/regence-bar-grande.jpg"
                  alt="Le Bar — grande photo"
                  class="block w-full h-auto object-contain md:h-[90vh] md:object-cover md:object-center"
                />
              </figure>

              <div class="hidden md:flex flex-col w-[35%]">
                <figure class="rounded-2xl soft-border overflow-hidden w-full">
                  <img
                    src="/regence-bar-petite.jpg"
                    alt="Le Bar — photo secondaire"
                    class="h-[40vh] w-full object-cover object-center"
                  />
                </figure>

                <div class="h-4"></div>

                <figure class="rounded-2xl soft-border overflow-hidden w-full">
                  <img
                    src="/regence-bar-petite-2.jpg"
                    alt="Le Bar — troisième photo"
                    class="h-[40vh] w-full object-cover object-center"
                  />
                </figure>
              </div>
            </div>
          </div>
        </section>

        <!-- ====== PAGE 2 : LE RESTAURANT ====== -->
        <section id="restaurant" class="md:snap-start md:min-h-full flex items-stretch py-0 md:py-8">
          <div class="w-full flex flex-col md:flex-row md:h-full">
            <!-- COLONNE GAUCHE : droite + bas -->
            <div class="order-2 md:order-1 md:w-1/2 flex flex-col items-center md:items-end text-center md:text-right justify-end px-6 md:pl-0 md:pr-10 py-10 md:pt-0 md:pb-20">
              <h2 class="font-limelight text-brand text-4xl md:text-6xl leading-none inline-block relative pt-4">
                <span class="absolute top-0 right-0 h-[3px] w-full bg-[var(--color-copper)] rounded-full"></span>
                Le Restaurant
              </h2>

              <div class="mt-4 text-slate-800 leading-relaxed text-lg">
                <p>
                  Cuisine de brasserie soignée, produits frais, recettes faites maison, esprit généreux.
                </p>
                <p class="mt-3">
                  Service midi & soir, pour déjeuner, trinquer, prolonger la soirée.
                </p>
              </div>
            </div>

            <!-- COLONNE DROITE -->
            <div class="order-1 md:order-2 w-full md:w-1/2 flex flex-col gap-4 md:pr-[3vw]">
              <figure class="w-full overflow-hidden rounded-none md:rounded-2xl md:soft-border">
                <img
                  src="/regence-restaurant-grande.jpg"
                  alt="Le Restaurant — grande photo"
                  class="block w-full h-auto object-contain md:h-[55vh] md:object-cover md:object-center"
                />
              </figure>

              <figure class="hidden md:block self-start rounded-2xl soft-border overflow-hidden">
                <img
                  src="/regence-restaurant-petite.jpg"
                  alt="Le Restaurant — photo secondaire"
                  class="w-[min(22vw,420px)] min-w-[280px] h-[28vh] object-cover object-center"
                />
              </figure>
            </div>
          </div>
        </section>

        <!-- ====== PAGE 3 : LA TERRASSE ====== -->
        <section id="terrasse" class="md:snap-start md:h-full flex items-stretch relative">
          <!-- Rectangle CUIVRE -->
          <div
            aria-hidden="true"
            class="hidden md:block absolute top-0 bottom-0 right-[4vw]
                   w-[min(28vw,500px)] min-w-[300px] bg-[var(--color-copper)]"
          ></div>

          <div class="w-full flex flex-col md:flex-row md:h-full relative z-10 py-0 md:py-8">
            <!-- COLONNE GAUCHE : droite + bas -->
            <div class="order-2 md:order-1 md:w-1/2 flex flex-col items-center md:items-end text-center md:text-right justify-end px-6 md:pl-0 md:pr-10 py-10 md:pt-0 md:pb-20">
              <h2 class="font-limelight text-brand text-4xl md:text-6xl leading-none inline-block relative pt-4">
                <span class="absolute top-0 right-0 h-[3px] w-full bg-[var(--color-copper)] rounded-full"></span>
                La Terrasse
              </h2>

              <div class="mt-4 text-slate-800 leading-relaxed text-lg">
                <p>
                  Au calme, en plein centre : la terrasse pour vos cafés, déjeuners et apéritifs ensoleillés.
                </p>
                <p class="mt-3">
                  Dès les beaux jours, service continu selon l’affluence.
                </p>
              </div>
            </div>

            <!-- COLONNE DROITE -->
            <div class="order-1 md:order-2 w-full md:w-1/2 flex flex-col gap-4 md:pr-[3vw]">
              <figure class="w-full overflow-hidden rounded-none md:rounded-2xl md:soft-border">
                <img
                  src="/regence-terrasse-grande.jpg"
                  alt="La Terrasse — grande photo"
                  class="block w-full h-auto object-contain md:h-[55vh] md:object-cover md:object-center"
                />
              </figure>

              <figure class="hidden md:block self-start rounded-2xl soft-border overflow-hidden">
                <img
                  src="/regence-terrasse-petite.jpg"
                  alt="La Terrasse — photo secondaire"
                  class="w-[min(22vw,420px)] min-w-[280px] h-[28vh] object-cover object-center"
                />
              </figure>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>

  <!-- Activation onglet courant + scroll align -->
  <script is:inline>
    (function () {
      const tabs = Array.from(document.querySelectorAll(".tab-link"));
      const ids = ["bar", "restaurant", "terrasse"];
      const secs = ids.map((id) => document.getElementById(id)).filter(Boolean);

      const setActive = (id) => {
        tabs.forEach((a) => {
          const active = a.dataset.tab === id;
          a.classList.toggle("text-[var(--color-copper)]", active);
          a.classList.toggle("text-brand", !active);
        });
      };

      const io = new IntersectionObserver(
        (entries) => {
          const vis = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!vis) return;
          setActive(vis.target.id);
        },
        {
          root: null,
          rootMargin: "-45% 0px -45% 0px",
          threshold: [0.01, 0.1, 0.25, 0.5],
        }
      );

      secs.forEach((s) => io.observe(s));

      // clic onglet -> scroll doux jusqu’à la section
      tabs.forEach((a) => {
        a.addEventListener("click", (e) => {
          const target = document.getElementById(a.dataset.tab);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: "smooth", block: "start" });
          setActive(a.dataset.tab);
        });
      });
    })();
  </script>
</SidebarLayout>